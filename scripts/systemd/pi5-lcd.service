[Unit]
Description=Pi5 Gateway Case LCD
After=pi5-backend.service
Wants=pi5-backend.service

# Tek kaynak: install.sh, post-update.sh ve backend (ensureLcdService) bu dosyayı /etc/systemd/system'e kopyalar.
[Service]
Type=simple
# SunFounder pironman5 aynı OLED'i / RGB'yi sürerse iki proses çakışır (ekran üst üste biner, LED rengi ezilir).
# Script modülleri bıraktırır ve gerekiyorsa pironman5'i yeniler; ayrıntı scripts/pironman_release.sh içinde.
# '-' öneki: script yoksa hata yut.
ExecStartPre=-/bin/sh /opt/pi5-gateway/scripts/pironman_release.sh
ExecStart=/usr/bin/python3 /opt/pi5-gateway/scripts/lcd_display.py run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
